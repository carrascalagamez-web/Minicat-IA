{
  "bot": {
    "name": "MINICAT IA",
    "prefix": ".",
    "website": "https://minicat-ia-production.up.railway.app/",
    "commands": {
      "chat": true,
      "mention": true,
      "reply": true
    }
  },
  "memory": {
    "enabled": true,
    "userControl": true,
    "allowAdd": true,
    "allowEdit": true,
    "allowDelete": true,
    "separateFromChats": true
  },
  "privacy": {
    "saveConversations": false,
    "saveTechnicalErrors": true
  },
  "interface": {
    "theme": "dark",
    "accentColor": "#397DCE",
    "responsive": true
  },
  "limits": {
    "textMessagesPerDay": 100,
    "imageMessagesPerDay": 2
  }
}
