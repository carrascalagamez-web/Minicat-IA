{
  "app": {
    "name": "MINICAT IA",
    "language": "es",
    "timezone": "America/Bogota"
  },
  "platforms": {
    "web": {
      "enabled": true,
      "discordLogin": true,
      "chat": true,
      "imageGeneration": true,
      "chatHistory": true
    },
    "discord": {
      "enabled": true,
      "respondToMentions": true,
      "respondToReplies": true,
      "prefix": ".",
      "chat": true,
      "imageGeneration": true,
      "attachments": true,
      "voiceMessages": true
    }
  },
  "ai": {
    "provider": "groq",
    "model": "CONFIGURE_IN_ENV",
    "maxTokens": 4096,
    "temperature": 0.7
  },
  "sharedSystem": {
    "sameUsers": true,
    "sameAI": true,
    "sameLimits": true,
    "samePreferences": true,
    "sameMemorySettings": true
  },
  "memory": {
    "enabled": true,
    "userControlled": true,
    "separatePerUser": true
  },
  "limits": {
    "free": {
      "messagesPerDay": 100,
      "imagesPerDay": 5
    },
    "premium": {
      "messagesPerDay": 3000,
      "imagesPerDay": 20
    },
    "premiumPlus": {
      "messagesPerDay": 10000,
      "imagesPerDay": 50
    }
  },
  "security": {
    "requireDiscordAuthentication": true,
    "maxLoginAttempts": 5
  },
  "privacy": {
    "storeConversationContent": true,
    "retentionDays": 30
  }
}
